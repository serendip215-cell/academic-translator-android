<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/retro_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_retro_yellow"
                android:gravity="center"
                android:text="文"
                android:textColor="@color/retro_ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="文献翻译助手"
                android:textColor="@color/retro_ink"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="为网页和 Zotero 的英文选区提供即时译文。"
            android:textColor="@color/retro_ink"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/retro_paper"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/retro_ink"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="首次使用需要的权限"
                    android:textColor="@color/retro_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvPermissionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/retro_ink"
                    android:textSize="13sp" />
                <Button
                    android:id="@+id/btnPermissionSetup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="检查并授权"
                    android:textAllCaps="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="@color/retro_paper"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp"
            app:strokeColor="@color/retro_ink"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="CURRENT TRANSLATION MODE"
                    android:textColor="@color/retro_ink"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvTranslationModeStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_retro_yellow"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"
                    android:textColor="@color/retro_ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgTranslationMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbWebMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_retro_blue"
                        android:minHeight="54dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp"
                        android:text="网页自动翻译"
                        android:textColor="@color/retro_ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="12dp"
                        android:text="网页中选中英文，自动显示译文。"
                        android:textColor="@color/retro_ink"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbZoteroMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_retro_pink"
                        android:minHeight="54dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp"
                        android:text="Zotero 分享翻译"
                        android:textColor="@color/retro_ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="5dp"
                        android:text="选中文本后，点“分享 → 文献翻译助手”。"
                        android:textColor="@color/retro_ink"
                        android:textSize="12sp" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.08"
            android:text="CONFIGURATION"
            android:textColor="@color/retro_ink"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTranslationEngine"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_retro_yellow"
            android:clickable="true"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:text="翻译引擎"
            android:textAllCaps="false"
            android:textColor="@color/retro_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnGlossary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_retro_pink"
            android:clickable="true"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:text="自定义术语"
            android:textAllCaps="false"
            android:textColor="@color/retro_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_retro_blue"
            android:clickable="true"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:text="检查更新"
            android:textColor="@color/retro_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
